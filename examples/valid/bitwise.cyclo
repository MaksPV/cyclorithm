schedule "bitwise" {
  point P {
    actions = [sh, sr, band, bxor, bor, prec, wrap, lshr, mod64, negsh, and5, addshl];
  }

  root_cycle start_time = "2026-01-01T00:00:00", duration = 1h {
    [1 << 3 == 8] 0m: P.sh();
    [256 >> 2 == 64] 5m: P.sr();
    [14 & 11 == 10] 10m: P.band();
    [7 ^ 3 == 4] 15m: P.bxor();
    [8 | 3 == 11] 20m: P.bor();
    [1 | 2 ^ 3 & 6 << 1 == 3] 25m: P.prec();
    [(1 << 63) + 9223372036854775807 == 0 - 1] 30m: P.wrap();
    [(0 - 1 >> 1) == 9223372036854775807] 35m: P.lshr();
    [1 << 64 == 1] 40m: P.mod64();
    [1 << (0 - 1) == 1 << 63] 45m: P.negsh();
    [5 & 3 == 1] 50m: P.and5();
    [1 + 2 << 3 == 24] 55m: P.addshl();
  }
}
