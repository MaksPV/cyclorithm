schedule "Автобусный парк" {
  point DEPOT {
    actions = [depart, arrive];
  }

  point AIRPORT {
    actions = [arrive, depart];
  }

  cycle CITY_ROUTE
    duration = 1h20m
  {
    0m: DEPOT.depart();
    -40m: AIRPORT.arrive();   // ≡ 40m, середина
    -10m: AIRPORT.depart();   // ≡ 70m
    -0m: DEPOT.arrive();      // ≡ 80m, ровно встык — валидно
  }

  root_cycle
    start_time = "2026-01-01T00:00:00",
    duration = 24h
  {
    6h: CITY_ROUTE();
    18h: CITY_ROUTE();
  }
}
