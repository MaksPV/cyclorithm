// julian.cyclo — юлианский календарь: разбор стены в юлианскую дату
// и сборка стены из юлианской даты. Только объявления, без расписания.
//
// Пролептический календарь (год 0 = 1 до н.э.). День недели абсолютен:
// j_dow — алиас dow (конверсия не нужна, зафиксировано здесь).
// Компоненты юлианской даты передаются словарём {"y","mo","d"}:
// julian_to_wall({"y": 2025, "mo": 12, "d": 25}).
// Кривые компоненты — division-by-zero от стража (в чистых выражениях
// правильный invalid-date недостижим, молчаливого мусора нет).

// Юлианский день стены (1970-01-01 = JDN 2440588).
fun j_jdn(t) = floordiv(t.wall, DAY) + 2440588;

// Разбор JDN в юлианскую дату (все деления — вниз, работает до эпохи).
fun __jc(t) = j_jdn(t) + 32082;
fun __jd(t) = floordiv(4 * __jc(t) + 3, 1461);
fun __je(t) = __jc(t) - floordiv(1461 * __jd(t), 4);
fun __jm(t) = floordiv(5 * __je(t) + 2, 153);

fun j_day(t) = __je(t) - floordiv(153 * __jm(t) + 2, 5) + 1;
fun j_month(t) = __jm(t) + 3 - 12 * floordiv(__jm(t), 10);
fun j_year(t) = __jd(t) - 4800 + floordiv(__jm(t), 10);

fun j_datestr(t) = pad(j_year(t), 4) ++ "-" ++ pad(j_month(t), 2) ++ "-" ++ pad(j_day(t), 2);
fun j_dow(t) = dow(t);

// Високосность и длина месяца — по юлианскому правилу (каждый 4-й год).
fun j_is_leap(t) = (floormod(j_year(t), 4) == 0);
fun j_days_in_month(t) = 31 - (j_month(t) == 4 or j_month(t) == 6 or j_month(t) == 9 or j_month(t) == 11)
  - (j_month(t) == 2) * (3 - j_is_leap(t));

// Сдвиг юлианской даты в днях для григорианского года (13 в 1900–2099,
// 14 с 2100 — дрейф формулой, не константой).
fun j_shift(y) = floordiv(y, 100) - floordiv(y, 400) - 2;

// Сборка JDN из юлианской даты-словаря.
fun __ja(j) = floordiv(14 - j.mo, 12);
fun __jy2(j) = j.y + 4800 - __ja(j);
fun __jm2(j) = j.mo + 12 * __ja(j) - 3;
fun __jjdn(j) = j.d + floordiv(153 * __jm2(j) + 2, 5) + 365 * __jy2(j) + floordiv(__jy2(j), 4) - 32083;

// Страж компонентов: 1/0, ноль роняет сборку делением на ноль.
// Короткое замыкание: j_days_in_month считается только при месяце 1..12.
fun __jvalid(j) = ((j.mo >= 1 and j.mo <= 12)
  and (j.d >= 1)
  and (j.d <= 31 - (j.mo == 4 or j.mo == 6 or j.mo == 9 or j.mo == 11) - (j.mo == 2) * (3 - (floormod(j.y, 4) == 0))));

// Стена григорианской даты, соответствующей юлианской (y, mo, d).
// Чистая арифметика от JDN: 29.02.1900 по-юлиански собирается,
// хотя григорианский mkdate(1900, 2, 29) — invalid-date.
fun julian_to_wall(j) = (__jjdn(j) - 2440588) * DAY + floordiv(0, __jvalid(j));
