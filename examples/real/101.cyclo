schedule "101 Кулички - Тамбов" {
  timezone = "+03:00"
  point KULICHKI {actions = [stop];}
  point TAMBOV {actions = [stop];}
  point TATANOVO {actions = [stop];}
  point DONSKOYE {actions = [stop];}

  cycle TAMBOV_KULICHKI
    duration = 50m
  {
    0m: TAMBOV.stop();
    10m: DONSKOYE.stop();
    30m: TATANOVO.stop();
    50m: KULICHKI.stop();
  }

  cycle KULICHKI_TAMBOV reverse TAMBOV_KULICHKI;


  root_cycle
    start_time = "2026-01-01T00:00:00",
    duration = 24h
  {
    [not weekend(at)] 6h50m: KULICHKI_TAMBOV();
    8h00m: TAMBOV_KULICHKI();
    9h00m: KULICHKI_TAMBOV();
    13h00m: TAMBOV_KULICHKI();
    14h00m: KULICHKI_TAMBOV();
    16h25m: TAMBOV_KULICHKI();
    17h20m: KULICHKI_TAMBOV();
    [not weekend(at)] 18h30m: TAMBOV_KULICHKI();
  }
}
