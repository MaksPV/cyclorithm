const Y = 9223372036854775807;

schedule "integer-out-of-range-mkdate" {
  point DEPOT {
    actions = [depart];
  }

  cycle R
    duration = 1h
  {
    0m: DEPOT.depart();
  }

  root_cycle
    start_time = "2026-01-01T00:00:00",
    duration = 24h
  {
    [mkdate(Y, 1, 1, 0, 0, 0, 0) == 0] 6h: R();
  }
}
