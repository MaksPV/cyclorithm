schedule "gaps-dynamic-moment" {
  point A {
    actions = [x];
  }

  cycle W
    duration = 2h
  {
    0m: A.x();
  }

  cycle P
    duration = 1h
  {
    0m: A.x();
  }

  root_cycle
    start_time = "2026-01-01T00:00:00",
    duration = 24h
  {
    0h: W() as W1;
    after W1: fill gaps P();
  }
}
