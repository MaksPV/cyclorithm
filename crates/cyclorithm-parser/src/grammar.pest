// Cyclorithm grammar — дословно §3 спеки (EBNF почти 1:1).
//
// Осознанно пропуски грамматики (ловит валидация, invalid-duration):
// - порядок/уникальность компонентов длительности (`1h2h`, `30s1d`);
// - переполнение i64 и нулевой период root_cycle.
//
// Ловушка: `ms` в альтернативе раньше `m`, иначе `1ms` режется на `m` + `s`.

file        = { SOI ~ use_decl* ~ decl* ~ schedule ~ EOI }
// Только объявления (системный файл): расписания там нет.
decls_file  = { SOI ~ decl* ~ EOI }
// Единица импорта: объявления и свои use, расписание — опционально
// (его наличие бракует резолвер (schedule-in-import), а не синтаксис).
unit_file   = { SOI ~ use_decl* ~ decl* ~ schedule? ~ EOI }
use_decl    = { "use" ~ string ~ ";" }
schedule    = { "schedule" ~ string ~ "{" ~ point* ~ routine* ~ cycle* ~ root_cycle ~ "}" }
// Объявления — только до schedule. Параметр предиката — буквально `at`
// (проверяет build); truth — сравнение в скобках для арифметики (1/0).
decl        = { const_decl | fun_decl | pred_decl | time_const_decl }
const_decl  = { "const" ~ IDENT ~ "=" ~ decl_value ~ ";" }
fun_decl    = { "fun" ~ IDENT ~ "(" ~ IDENT ~ ")" ~ "=" ~ decl_value ~ ";" }
pred_decl   = { "pred" ~ IDENT ~ "(" ~ IDENT ~ ")" ~ "=" ~ or_expr ~ ";" }
// Таблица слотов (§3): именованные смещения для routine; `->` — слот
// и собственный вызов в одном лице (пожар при каждом инстанцировании).
time_const_decl = { "time_const" ~ IDENT ~ "duration" ~ "=" ~ duration ~ "{" ~ slot_row* ~ "}" }
slot_row    = { condition_block? ~ label ~ ":" ~ duration ~ slot_fire? ~ ";" }
slot_fire   = { "->" ~ invocation }
// Метка слота: цифры в начале разрешены (`1st`, `lunch_start`).
// Ловушка как с `ms`: `1ms` разберётся длительностью, а не меткой
// (в `routine_offset` длительность пробуется раньше) — таких имён не давать.
label       = @{ (ASCII_ALPHANUMERIC | "_")+ }
// Тело const/fun — склейка или битовое выражение (datestr возвращает строку).
// Порядок как у операндов: сначала concat, иначе bitor съедает префикс.
decl_value  = { concat | bitor }
point       = { "point" ~ IDENT ~ "{" ~ "actions" ~ "=" ~ "[" ~ action_list ~ "]" ~ ";" ~ point_attrs? ~ "}" }
action_list = { IDENT ~ ("," ~ IDENT)* }
// Атрибуты точки (§3 спеки): только литерал или ссылка на константу-мапу,
// строк `k = v;` нет. Дубли ключей ловит валидация (duplicate-attribute), не синтаксис.
point_attrs = { "attrs" ~ "=" ~ attrs_src ~ ";" }
attrs_src   = { map_lit | IDENT }
cycle       = { "cycle" ~ IDENT ~ cycle_params? ~ "duration" ~ "=" ~ duration ~ "{" ~ stmt* ~ "}" }
// Параметры цикла (§3): дубли (`cycle C(a, a)`) ловит валидация (duplicate).
cycle_params = { "(" ~ IDENT ~ ("," ~ IDENT)* ~ ")" }
root_cycle  = { "root_cycle" ~ "start_time" ~ "=" ~ string ~ "," ~ "duration" ~ "=" ~ duration ~ "{" ~ stmt* ~ "}" }
// Шаблон дня (§3): первый параметр — таблица (`time_const`), остальные —
// данные как у цикла. В теле метки стоят вместо смещений; вызов routine —
// тот же `cycle_call` (`MONDAY(DAY)`), routine от цикла отличит валидация.
routine     = { "routine" ~ IDENT ~ cycle_params? ~ "{" ~ routine_stmt* ~ "}" }
routine_stmt = { condition_block? ~ routine_offset ~ ":" ~ stmt_body ~ ";" }
// Сначала длительность, потом метка: иначе `45m` съестся как метка.
// Граница `!word_tail` — чтобы `1st` не резалось на длительность `1s` + мусор:
// PEG не возвращается в альтернативу, если правило уже успело (потом падает `:`).
// Минус — только у длительности (`-10m` от конца таблицы; `-1st` нет).
routine_offset = { neg_sign? ~ duration ~ !word_tail | label }
stmt        = { condition_block? ~ neg_sign? ~ duration ~ ":" ~ stmt_body ~ ";" }
// Условия (§3 спеки). `concat` раньше `bitor`: иначе `bitor` съедает
// строковый префикс. Смешение типов разбирается, бракуется валидацией (type-mismatch).
condition_block = { "[" ~ condition ~ "]" }
condition   = { or_expr }
or_expr     = { and_expr ~ (kw_or ~ and_expr)* }
and_expr    = { not_expr ~ (kw_and ~ not_expr)* }
not_expr    = { kw_not? ~ (bool_group | comparison | call) }
// Скобочная группа — прозрачный атом уровня условий (как в C/Python):
// приоритет задаёт пользователь, узла в AST нет (сборка вернёт внутреннее).
bool_group  = { "(" ~ or_expr ~ ")" }
// `notx == 1` не должно читаться как `not (x == 1)`.
// Атомарные: пробел между словом и границей запрещён, иначе lookahead
// смотрел бы символ после пробелов, а не сразу за словом.
kw_or       = @{ "or" ~ !word_tail }
kw_and      = @{ "and" ~ !word_tail }
kw_not      = @{ "not" ~ !word_tail }
word_tail   = _{ ASCII_ALPHANUMERIC | "_" }
comparison  = { cmp_side ~ cmp_op ~ cmp_right }
// Длинные операторы раньше коротких, иначе `<=` режется на `<` + `=`.
cmp_op      = { "==" | "!=" | "<=" | ">=" | "<" | ">" }
cmp_side    = { concat | bitor }
cmp_right   = { concat | bitor | alternation }
alternation = { "(" ~ bitor ~ (kw_or ~ bitor)+ ~ ")" }
// Битовые уровни (слабее сложения, сильнее сравнения; внутри — как в Python:
// `|` слабее `^`, `^` слабее `&`, сдвиги сильнее всех трёх).
bitor       = { bitxor ~ ("|" ~ bitxor)* }
bitxor      = { bitand ~ ("^" ~ bitand)* }
bitand      = { shift ~ ("&" ~ shift)* }
shift       = { arith ~ (shift_op ~ arith)* }
shift_op    = { "<<" | ">>" }
arith       = { term ~ (add_op ~ term)* }
add_op      = { "+" | "-" }
term        = { factor ~ (mul_op ~ factor)* }
mul_op      = { "floordiv" | "floormod" | "*" | "/" | "%" }
factor      = { neg_sign? ~ (postfix | "(" ~ bitor ~ ")") }
// Мостик булева в арифметику (как в C: истина — 1, ложь — 0):
// внутри скобок полное условие, а не одно сравнение.
truth       = { "(" ~ or_expr ~ ")" }
concat      = { concat_term ~ ("++" ~ concat_term)+ }
concat_term = { postfix | "(" ~ concat ~ ")" }
// Постфикс (§3): доступ к полю мапы (`.name`, цепочки) и индекс массива
// (`[0]`). `BELL.ring()` остаётся вызовом: различие по скобке —
// `IDENT.IDENT(` разбирает `point_action` на уровне строк, а не выражение.
// Вычисляемых ключей нет: в скобках только целочисленный литерал
// (минус пишется слитно, как у смещений; `-1` даст index-out-of-bounds в момент строки).
postfix     = { postfix_base ~ postfix_suffix* }
// Порядок как у операндов: `call` раньше `bool_lit`, иначе `true(x)`
// режется на литерал + мусор; `bool_lit` раньше `IDENT`, иначе `true`
// читается именем. `truth` раньше скобок — как было в `factor`.
postfix_base = { number | string | map_lit | array_lit | call | bool_lit | IDENT | truth | "(" ~ bitor ~ ")" }
postfix_suffix = { field_access | index_access }
field_access = { "." ~ IDENT }
// Атомарное: пробелы внутри скобок запрещены (`m[0]` ок, `m[ 0]` — ошибка),
// минус пишется слитно (`m[-1]`).
index_access = @{ "[" ~ "-"? ~ ASCII_DIGIT+ ~ "]" }
// JSON-литералы (§3): содержимое — только литералы (чистые данные,
// без вычислений). Висячих запятых нет (строго, как везде).
map_lit     = { "{" ~ (map_pair ~ ("," ~ map_pair)*)? ~ "}" }
// Ключ — отдельное правило (не `string`): атомарное строковое правило
// пары не даёт, а ключ нужен сборке отдельно от значения.
map_pair    = { map_key ~ ":" ~ literal_value }
map_key     = ${ "\"" ~ string_char* ~ "\"" }
array_lit   = { "[" ~ (literal_value ~ ("," ~ literal_value)*)? ~ "]" }
literal_value = { number | string | bool_lit | map_lit | array_lit }
// Атомарное с границей слова: `truex` — имя, а не литерал + мусор.
bool_lit    = @{ ("true" | "false") ~ !word_tail }
call        = { IDENT ~ "(" ~ (cond_arg ~ ("," ~ cond_arg)*)? ~ ")" }
cond_arg    = { concat | bitor }
// Тело строки: сначала пробуем модификатор + вызов, иначе голый вызов.
// Порядок важен: цикл с именем `fill` (`6h: fill();`) разбирается второй
// веткой — PEG сбрасывает позицию при неудаче первой.
stmt_body   = { repeat_mod ~ invocation | invocation }
repeat_mod  = { repeat_n | fill_mod }
repeat_n    = { "repeat" ~ number }
fill_mod    = { "fill" ~ ("until" ~ neg_sign? ~ duration)? }
// Минус смещения — именованное правило, чтобы парсер его видел; слитность
// (`-10m` ок, `- 10m` — ошибка) проверяется в `build_stmt` по спанам:
// неявные пробелы `~` здесь пропускают пробел осознанно.
neg_sign    = { "-" }
invocation  = { point_action | cycle_call }
// Блок действий (§3): только у вызова точки; у цикла после `)` блока нет
// (иначе синтаксис). Ключи — IDENT, значения — выражения уровня условий.
point_action = { IDENT ~ "." ~ IDENT ~ "(" ~ ")" ~ action_block? }
action_block = { "{" ~ (block_pair ~ ("," ~ block_pair)*)? ~ "}" }
block_pair   = { IDENT ~ "=" ~ cond_arg }
cycle_call   = { IDENT ~ "(" ~ (cond_arg ~ ("," ~ cond_arg)*)? ~ ")" }
duration     = { duration_item+ }
// Компакт-атомарное: внутри компонента пробелы запрещены (`1 h` — ошибка),
// между компонентами разрешены (`1h 20m` ок).
duration_item = ${ number ~ duration_unit }
duration_unit = { "ms" | "w" | "d" | "h" | "m" | "s" }
number        = @{ ASCII_DIGIT+ }
// Атомарное: комментарии `//` и пробелы внутрь строк не проникают.
string      = @{ "\"" ~ string_char* ~ "\"" }
string_char = _{ !("\"" | "\n" | "\r") ~ ANY }
// ASCII-only: кириллица в именах запрещена (проверяется самим классом).
IDENT = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
// Строчные комментарии до конца строки — как пробелы; блочных нет.
COMMENT = _{ "//" ~ (!"\n" ~ ANY)* }
